# Trailytics Phase 1 distribution settings. Internal Opik identifiers remain unchanged.
OPIK_VERSION=2.2.138
OPIK_COMMIT=28192d8ffe85299f5c44032f705a9e518e6d1189
TRAILYTICS_FRONTEND_IMAGE=trailytics-frontend:2.2.138
TRAILYTICS_DASHBOARD_PORT=5173
# Stable Docker Compose identity. The upstream launcher derives this value from
# the submodule path; the scripts assert it before touching any container so a
# checkout can never drift onto a different (or somebody else's) deployment.
TRAILYTICS_COMPOSE_PROJECT=opik-opik
CREATE_DEMO_DATA=false
OPIK_FRONTEND_PULL_POLICY=never
# Upstream sends an anonymous install report unless this is explicitly false.
TRAILYTICS_USAGE_REPORT_ENABLED=false
TRAILYTICS_STARTUP_TIMEOUT_SECONDS=600
TRAILYTICS_STARTUP_ATTEMPTS=3
TRAILYTICS_STARTUP_RETRY_DELAY_SECONDS=15
